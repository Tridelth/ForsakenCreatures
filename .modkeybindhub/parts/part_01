            // Prefer the exact set the active BepInEx input adapter says it can read.
            try
            {
                if (_inputSystem != null && _inputSupportedKeyCodes != null)
                {
                    IEnumerable supported = _inputSupportedKeyCodes.GetValue(_inputSystem, null) as IEnumerable;
                    if (supported != null)
                    {
                        foreach (object raw in supported)
                        {
                            if (!(raw is KeyCode))
                            {
                                continue;
                            }
                            KeyCode key = (KeyCode)raw;
                            if (!_captureKeys.Contains(key) && IsKeyboardMouseKey(key))
                            {
                                _captureKeys.Add(key);
                            }
                        }
                    }
                }
            }
            catch
            {
                _captureKeys.Clear();
            }

            if (_captureKeys.Count > 0)
            {
                return;
            }

            // BepInEx KeyboardShortcut supplies a compatible key list on older builds.
            try
            {
                foreach (KeyCode key in KeyboardShortcut.AllKeyCodes)
                {
                    if (!_captureKeys.Contains(key) && IsKeyboardMouseKey(key))
                    {
                        _captureKeys.Add(key);
                    }
                }
            }
            catch
            {
                Array values = Enum.GetValues(typeof(KeyCode));
                foreach (object raw in values)
                {
                    KeyCode key = (KeyCode)raw;
                    if (!_captureKeys.Contains(key) && IsKeyboardMouseKey(key))
                    {
                        _captureKeys.Add(key);
                    }
                }
            }
        }

        private static bool IsKeyboardMouseKey(KeyCode key)
        {
            if (key == KeyCode.None)
            {
                return false;
            }

            string n = key.ToString();
            if (n.StartsWith("Joystick", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            return true;
        }

