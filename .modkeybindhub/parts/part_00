        private void Awake()
        {
            _fallbackOpenKey = Config.Bind<KeyboardShortcut>("General", "FallbackOpenKey", new KeyboardShortcut(KeyCode.F8),
                "Fallback shortcut for opening Mod Keybind Hub if the Settings-page button cannot be reached. Set to None to disable.");
            _scanStringCandidates = Config.Bind<bool>("Detection", "ScanStringKeybinds", true,
                "Detect strongly keybind-looking string settings such as HotKey = v. These are only editable when the format is understood safely.");
            _scanRawFields = Config.Bind<bool>("Detection", "ScanRawKeyFields", true,
                "Detect writable static/plugin KeyCode and KeyboardShortcut fields used by mods that did not expose a BepInEx config entry.");
            _scanFileOnlyCandidates = Config.Bind<bool>("Detection", "ShowFileOnlyCandidates", true,
                "Show keybind-looking entries found only in BepInEx .cfg files. They are reported as read-only because changing them may require a restart or a mod-specific reload.");
            _showVanillaCollisions = Config.Bind<bool>("Detection", "ShowVanillaCollisions", true,
                "Check detected mod binds against currently registered Valheim keyboard/mouse ZInput actions when available.");
            _debugLogging = Config.Bind<bool>("General", "DebugLogging", false,
                "Write verbose Mod Keybind Hub detection information to the BepInEx log.");

            InitializeInputAdapter();
            BuildCaptureKeyList();
            BuildOverlayUi();

            Logger.LogInfo("Mod Keybind Hub " + PluginVersion + " loaded. It will add MOD KEYBINDS to Keyboard & Mouse settings. Fallback opener: " + _fallbackOpenKey.Value + ".");
        }

        private void OnDestroy()
        {
            if (_canvasObject != null)
            {
                Destroy(_canvasObject);
            }
        }

        private void Update()
        {
            HandleCapture();

            if (_captureTarget == null && Time.unscaledTime >= _nextOpenKeyAllowedTime)
            {
                KeyboardShortcut openKey = _fallbackOpenKey.Value;
                if (openKey.MainKey != KeyCode.None && openKey.IsDown())
                {
                    _nextOpenKeyAllowedTime = Time.unscaledTime + 0.35f;
                    TogglePanel();
                }
            }

            if (Time.unscaledTime >= _nextUiProbeTime)
            {
                _nextUiProbeTime = Time.unscaledTime + 1.0f;
                TryInstallSettingsLauncher();
            }

            if (_panelVisible && _searchField != null)
            {
                string current = _searchField.text ?? string.Empty;
                if (!string.Equals(current, _lastSearch, StringComparison.Ordinal))
                {
                    _lastSearch = current;
                    RebuildRows();
                }
            }
        }

        private void InitializeInputAdapter()
        {
            _inputSystem = null;
            _inputGetKeyDown = null;
            _inputGetKey = null;
            _inputSupportedKeyCodes = null;

            try
            {
                Type unityInputType = typeof(BaseUnityPlugin).Assembly.GetType("BepInEx.UnityInput", false);
                if (unityInputType == null)
                {
                    return;
                }

                PropertyInfo currentProperty = unityInputType.GetProperty("Current", BindingFlags.Public | BindingFlags.Static);
                if (currentProperty == null)
                {
                    return;
                }

                _inputSystem = currentProperty.GetValue(null, null);
                if (_inputSystem == null)
                {
                    return;
                }

                Type inputType = _inputSystem.GetType();
                _inputGetKeyDown = inputType.GetMethod("GetKeyDown", BindingFlags.Public | BindingFlags.Instance, null, new Type[] { typeof(KeyCode) }, null);
                _inputGetKey = inputType.GetMethod("GetKey", BindingFlags.Public | BindingFlags.Instance, null, new Type[] { typeof(KeyCode) }, null);
                _inputSupportedKeyCodes = inputType.GetProperty("SupportedKeyCodes", BindingFlags.Public | BindingFlags.Instance);

                if (_debugLogging != null && _debugLogging.Value)
                {
                    Logger.LogInfo("Input capture adapter: " + inputType.FullName);
                }
            }
            catch (Exception ex)
            {
                _inputSystem = null;
                _inputGetKeyDown = null;
                _inputGetKey = null;
                _inputSupportedKeyCodes = null;
                DebugLog("BepInEx UnityInput adapter unavailable; falling back to UnityEngine.Input. " + ex.Message);
            }
        }

        private bool InputKeyDown(KeyCode key)
        {
            if (_inputSystem != null && _inputGetKeyDown != null)
            {
                try
                {
                    object value = _inputGetKeyDown.Invoke(_inputSystem, new object[] { key });
                    if (value is bool)
                    {
                        return (bool)value;
                    }
                }
                catch
                {
                    // Fall through to legacy input.
                }
            }

            try { return Input.GetKeyDown(key); } catch { return false; }
        }

        private bool InputKeyHeld(KeyCode key)
        {
            if (_inputSystem != null && _inputGetKey != null)
            {
                try
                {
                    object value = _inputGetKey.Invoke(_inputSystem, new object[] { key });
                    if (value is bool)
                    {
                        return (bool)value;
                    }
                }
                catch
                {
                    // Fall through to legacy input.
                }
            }

            try { return Input.GetKey(key); } catch { return false; }
        }

