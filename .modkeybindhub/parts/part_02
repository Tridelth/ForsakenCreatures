        private void TogglePanel()
        {
            if (_panelVisible)
            {
                ClosePanel();
            }
            else
            {
                OpenPanel();
            }
        }

        private void OpenPanel()
        {
            _panelVisible = true;
            _canvasObject.SetActive(true);
            _captureTarget = null;
            _captureText.text = string.Empty;
            _statusText.text = "Scanning loaded mods...";
            Cursor.visible = true;
            Cursor.lockState = CursorLockMode.None;
            ScanAllBindings(false);
        }

        private void ClosePanel()
        {
            _captureTarget = null;
            _panelVisible = false;
            if (_canvasObject != null)
            {
                _canvasObject.SetActive(false);
            }
        }

        private void ScanAllBindings(bool userRequested)
        {
            _bindings.Clear();
            _externalBindings.Clear();
            _seenConfigEntries.Clear();
            _seenIds.Clear();

            int pluginCount = 0;
            try
            {
                foreach (KeyValuePair<string, PluginInfo> kv in Chainloader.PluginInfos)
                {
                    PluginInfo info = kv.Value;
                    if (info == null || info.Instance == null)
                    {
                        continue;
                    }

                    pluginCount++;
                    ScanPlugin(info);
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning("Mod Keybind Hub: plugin scan encountered an error: " + ex.Message);
            }

            try
            {
                ScanJotunnButtons();
            }
            catch (Exception ex)
            {
                DebugLog("Jotunn scan failed safely: " + ex);
            }

            if (_scanFileOnlyCandidates.Value)
            {
                try
                {
                    ScanFileOnlyCandidates();
                }
                catch (Exception ex)
                {
                    DebugLog("File-only scan failed safely: " + ex);
                }
            }

            if (_showVanillaCollisions.Value)
            {
                try
                {
                    ScanZInputExternalBindings();
                }
                catch (Exception ex)
                {
                    DebugLog("ZInput external collision scan failed safely: " + ex);
                }
            }

            RefreshAllCurrentValues();
            CalculateConflicts();
            SortBindings();
            RebuildRows();

            int editable = 0;
            int exact = 0;
            int possible = 0;
            for (int i = 0; i < _bindings.Count; i++)
            {
                if (_bindings[i].Editable) editable++;
                if (_bindings[i].Conflict == ConflictLevel.Exact) exact++;
                else if (_bindings[i].Conflict == ConflictLevel.Possible) possible++;
            }

            _summaryText.text = _bindings.Count + " binds • " + editable + " editable • " + exact + " exact conflicts • " + possible + " possible";
            _statusText.text = "Scanned " + pluginCount + " loaded BepInEx plugins. Config-backed changes save immediately; raw/Jötunn runtime overrides are also persisted by this hub.";

            if (userRequested)
            {
                Logger.LogInfo("Mod Keybind Hub rescan: " + _bindings.Count + " binds, " + exact + " exact conflicts, " + possible + " possible overlaps.");
            }
        }

